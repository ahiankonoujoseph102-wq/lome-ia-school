APP_NAME="Lomé IA School"
APP_ENV=local
APP_KEY=
# Changement de clé (clé exposée) : ancienne clé ici le temps de lancer « php artisan app:reencrypt-data »,
# puis vider (voir CLAUDE.md, « Changer la clé APP_KEY »).
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Lome

# Laravel Cloud (site derrière un proxy) : TRUSTED_PROXIES=* pour la vraie adresse IP des visiteurs
# (anti-spam de la consultation, affiliation) et le https. Vide sur Hostinger.
TRUSTED_PROXIES=

# Bandeau « Version de test » en haut de toutes les pages (n'a aucun effet sur Google).
# true pendant une mise en ligne de test ; false sur le site définitif.
TEST_BANNER=false
# Texte du bandeau (facultatif ; vide = « Version de test : le site est en cours de préparation. »)
TEST_BANNER_TEXT=

# Blocage de Google et des autres moteurs de recherche (noindex + « Disallow: / » dans robots.txt).
# true tant que le site est sur une adresse provisoire (ex. lomeiaschool.laravel.cloud) ;
# false sur le nom de domaine définitif, pour être trouvé sur Google.
NOINDEX=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Développement : SQLite. Production (Hostinger) : mysql + variables DB_* ci-dessous.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lome_ia_school
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En ligne (https) : true.
# SESSION_SECURE_COOKIE=true

# Temps réel des groupes de discussion.
# null tant qu'il n'y a pas de compte Pusher : le chat se met à jour automatiquement toutes les quelques
# secondes. Avec un compte Pusher : pusher + les trois clés ci-dessous (Channels > App Keys).
# Sécurité : si BROADCAST_CONNECTION=pusher mais qu'une clé manque, le site bascule seul sur « null »
# (aucun plantage, ni au déploiement ni pendant la navigation).
BROADCAST_CONNECTION=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
FILESYSTEM_DISK=local
# Fichiers envoyés (App\Support\FileStorage). « local » = dossiers du serveur (Hostinger).
# Laravel Cloud : nom de disque donné à chaque bucket (privé : prive, public : publics).
# Autre stockage compatible S3 : « s3 » et les variables AWS_* plus bas.
PRIVATE_FILES_DISK=local
PUBLIC_FILES_DISK=local

# File d'attente traitée chaque minute par les tâches planifiées (schedule:run), sans processus permanent.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Développement : e-mails écrits dans storage/logs/laravel.log.
# Test sur Laravel Cloud (gratuit) : Brevo, MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
# MAIL_USERNAME = identifiant SMTP Brevo, MAIL_PASSWORD = clé SMTP Brevo (jamais dans le code ni dans le chat).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Fournisseur des vidéos de leçons (config/video.php) : youtube aujourd'hui, bunny plus tard
VIDEO_PROVIDER=youtube

# Notifications sur téléphone (Web Push) : clés créées avec « php artisan app:webpush-keys ».
# Vides = pas de notification sur téléphone (le reste du site fonctionne normalement).
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT="mailto:academyjoseph71@gmail.com"

# Assistante « Ama » : API Gemini de Google, appelée uniquement par le serveur (jamais dans le navigateur).
# Clé créée dans Google AI Studio (offre gratuite). GEMINI_MODEL : nom exact du modèle (voir CLAUDE.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
